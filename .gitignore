# Corpus harness downloads: public documents, but large and re-fetchable.
.corpus-cache/
corpus-report.json
# The retrieved-document cache, if IBID_CACHE_DIR is ever pointed inside the tree. It
# defaults to a platform cache directory outside any checkout — this is a guard, not the
# usual location. See docs/DATA-FLOW.md.
.ibid-cache/


# The one sample that is real material rather than constructed: the Commission's published
# DSA decision, 2.8MB of PDF and the .docx built from it. Kept locally — the corpus harness
# and the manual Word checks both use it, and it is what the add-in actually meets at full
# length — but not published here. It is public and yet names real parties, so it is not the
# file to hand someone along with the source, and the three constructed samples beside it
# cover every recognition path without naming anyone. See samples/ibid-demo-docx/README.md.
samples/ibid-demo-docx/Commission_decision_X_DSA.pdf
samples/ibid-demo-docx/Commission_decision_X_DSA.docx

# Word lock files, written beside a document while it is open.
~$*

# Throwaway trial state: the tunnel URL of the day, its logs, and the add-in Id.
# The Id is deliberately kept across runs but is local to this machine.
.trial/
